## Usando while crer un programa que me de un pregunta para responder y que solo teng 3 oportunidades para dar con la respuesta correcta
# Pregunta y respuesta correcta
## Usando while: Adivina el color
## Tienes solo 3 oportunidades
## Usando while: Adivina el color
## Tienes solo 3 oportunidades

pregunta = "¿De que color es el cielo en un dia despejado? "
respuesta_correcta = "azul"

intentos = 1
salir = "N"

while salir == "N":
    respuesta = input(pregunta)
    
    if respuesta == respuesta_correcta:
        print("Correcto! El cielo es azul")
        salir = "S"
    else:
        if intentos < 3:
            print("Incorrecto. Intento", intentos)
            intentos = intentos + 1
        else:
            print("Incorrecto. Se acabaron tus 3 oportunidades")
            print("La respuesta correcta era:", respuesta_correcta)
            salir = "S"

print("Adios")
